# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key — do NOT prefix with NEXT_PUBLIC_, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3 key (server-only)
YOUTUBE_API_KEY=

# Gemini API key (free tier, aistudio.google.com/apikey) — server-only
GEMINI_API_KEY=

# Gmail SMTP for the daily digest email (myaccount.google.com/apppasswords)
EMAIL_FROM=
EMAIL_APP_PASSWORD=
EMAIL_TO=

# Meta Graph API for Instagram competitor posts (server-only — never NEXT_PUBLIC_).
# Use a long-lived token (System User or Page token), not a Graph API Explorer
# token — Explorer tokens expire within hours. See README "Instagram 수집".
META_ACCESS_TOKEN=
# Instagram Business account ID linked to the authenticating Facebook Page
INSTAGRAM_USER_ID=17841402307485379
META_GRAPH_API_VERSION=v26.0
# Optional: max posts fetched per account per run (default 25)
# INSTAGRAM_MAX_POSTS_PER_ACCOUNT=25
